        "selectors": [
          "materialIds",
          "formula",
          "elements",
          "elementsMode",
          "chemsys",
          "bandGap",
          "energyAboveHull",
          "density",
          "volume",
          "numSites",
          "isStable",
          "isMetal",
          "hasProps",
          "fields",
          "maxResults",
          "maxPages"
        ]
      },
      "outputSchema": {
        "record": "MaterialRecord with raw source data and provenance",
