# This file is documentation only; pi-scholar does NOT automatically load .env files.
# Optional explicit JSON configuration path. Environment variables override JSON values.
PI_SCHOLAR_CONFIG=/path/to/pi-scholar.config.json
ZOTERO_BASE_URL=http://127.0.0.1:23119/api
ZOTERO_TIMEOUT_MS=15000
ZOTERO_MAX_ITEMS=5000
# Optional fallback for storage: attachment paths; directory containing Zotero's storage/ folder
ZOTERO_DATA_DIR=/path/to/Zotero
PI_SCHOLAR_OUTPUT_DIR=/path/to/plain-markdown-output
PI_SCHOLAR_FILENAME_SEPARATOR=+
PI_SCHOLAR_ASSETS_SUFFIX=.assets
PI_SCHOLAR_ASSET_FILE_PREFIX=figure
PI_SCHOLAR_METADATA_FILE=metadata.json
PI_SCHOLAR_TAG_SPACE_REPLACEMENT=-
MINERU_API_TOKEN=replace-with-token
MINERU_TIMEOUT_MS=600000
MINERU_POLL_INITIAL_MS=3000
MINERU_POLL_MAX_MS=15000
MINERU_MAX_ATTEMPTS=120
MINERU_LANGUAGE=en
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_MODEL_VERSION=vlm
# Ai4Scholar (also supports AI4S_API_KEY and ~/.pi/agent/ai4scholar.json)
AI4SCHOLAR_API_KEY=replace-with-key
# AI4SCHOLAR_BASE_URL and AI4SCHOLAR_TIMEOUT_MS are inherited from pi-ai4scholar.
